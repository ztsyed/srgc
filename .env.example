# Copy this file to .env.local and fill in real values.
# Never commit the populated .env.local — it's gitignored.

# Generate with: openssl rand -base64 32
AUTH_SECRET=

# From Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated list of Google account emails allowed to sign in.
ALLOWED_EMAILS=

# LLM backend for the /admin newsletter parse and the /chat copilot:
#   anthropic — Claude via the API (needs ANTHROPIC_API_KEY)
#   ollama    — a local model served by Ollama (needs OLLAMA_BASE_URL)
# Unset: Anthropic if ANTHROPIC_API_KEY is set, else Ollama.
# PARSE_LLM_PROVIDER / CHAT_LLM_PROVIDER override it per feature.
LLM_PROVIDER=
PARSE_LLM_PROVIDER=
CHAT_LLM_PROVIDER=

# From console.anthropic.com.
ANTHROPIC_API_KEY=

# Ollama, e.g. gpt-oss on the DGX. The Ollama path extracts PDF text with
# pdftotext, so poppler must be installed locally (brew install poppler).
OLLAMA_BASE_URL=http://192.168.45.124:11434
OLLAMA_MODEL=gpt-oss:120b
# Must match the context the model is loaded with, or Ollama reloads it.
OLLAMA_NUM_CTX=65536

DATA_DIR=./data
NEXTAUTH_URL=http://localhost:3000

# Public hostname for the deployed app, used by scripts/install.sh
# (e.g. srgc.example.com). Local dev does not need this.
DEPLOY_HOST=
